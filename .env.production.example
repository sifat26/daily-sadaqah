# ============================================================================
# Daily Sadaqah — Vercel & Production Environment Variables (.env.production)
# Copy these into your Vercel Project Settings > Environment Variables
# ============================================================================

NODE_ENV="production"

# 1. Cloud Database URL (NeonDB or Supabase Free Serverless Postgres)
# Example for Neon: postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Example for Supabase: postgresql://postgres:YOUR_PASSWORD@db.xxxx.supabase.co:5432/postgres
DATABASE_URL="YOUR_NEON_OR_SUPABASE_POSTGRES_URL"

# 2. Site URL
NEXT_PUBLIC_SITE_URL="https://your-project.vercel.app"
NEXT_PUBLIC_API_BASE_URL="https://your-project.vercel.app/api"

# 3. Security & Session Secrets (Generate with: openssl rand -hex 32)
SESSION_SECRET="e4c194e92b8d0c6fa4d52140a8362d854f9a0c6a51d23b7e804f58f0cb672f12"
CSRF_SECRET="64b5e28a9b1c7f4058d92a10c73e895471a0d84c62b53e8194f06cb758e19a34"
SESSION_COOKIE_NAME="ds_session"
SESSION_TTL_HOURS=168

# 4. Verified Manual Donation Numbers (bKash & Nagad Send Money)
BKASH_RECEIVING_NUMBER="01681253714"
NAGAD_RECEIVING_NUMBER="01681253714"

# 5. OTP / SMS Provider
# For initial production testing without paid SMS gateway: "console-dev"
# For live SMS gateway in Bangladesh: "sms-gateway"
OTP_PROVIDER="console-dev"
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Optional SMS Gateway credentials (if using Greenweb, SSL Wireless, or BulkSMSBD):
SMS_GATEWAY_API_URL=""
SMS_GATEWAY_API_KEY=""
SMS_GATEWAY_SENDER_ID=""

