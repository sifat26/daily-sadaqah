# ============================================================================
# Daily Sadaqah — Environment Configuration Example (.env.example)
# Copy this file to .env and fill in values for your environment.
# NEVER commit a real .env file or production secrets to version control.
# ============================================================================

NODE_ENV=development

# --- Database (PostgreSQL) ---
POSTGRES_USER=sadaqah_user
POSTGRES_PASSWORD=sadaqah_local_dev_password
POSTGRES_DB=daily_sadaqah
POSTGRES_PORT=5432
DATABASE_URL="postgresql://sadaqah_user:sadaqah_local_dev_password@localhost:5432/daily_sadaqah?schema=public"

# --- Backend API Server ---
API_PORT=4000
API_HOST=0.0.0.0
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# --- Frontend Web App ---
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000/api"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Security & Sessions ---
# Generate with: openssl rand -hex 32
SESSION_SECRET="replace-with-at-least-32-bytes-cryptographic-secret-key"
CSRF_SECRET="replace-with-at-least-32-bytes-csrf-secret-key"
SESSION_COOKIE_NAME="ds_session"
SESSION_TTL_HOURS=168

# --- Manual Donation Receiving Numbers (Personal bKash / Nagad) ---
# Do NOT hardcode real numbers in source code. Configure via environment variables:
BKASH_RECEIVING_NUMBER="01681253714"
NAGAD_RECEIVING_NUMBER="01681253714"

# --- OTP / SMS Provider Configuration ---
# Supported values: "console-dev" (development only) | "sms-gateway"
OTP_PROVIDER="console-dev"
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Required only when OTP_PROVIDER="sms-gateway"
SMS_GATEWAY_API_URL=""
SMS_GATEWAY_API_KEY=""
SMS_GATEWAY_SENDER_ID=""

# --- File Storage Configuration ---
# Supported values: "local" | "s3"
STORAGE_DRIVER="local"
LOCAL_PRIVATE_STORAGE_DIR="./storage/private"
LOCAL_PUBLIC_STORAGE_DIR="./storage/public"
MAX_UPLOAD_FILE_SIZE_BYTES=5242880
FILE_SIGNING_SECRET="replace-with-32-byte-file-signing-secret"

# Required only when STORAGE_DRIVER="s3"
S3_ENDPOINT=""
S3_REGION="ap-southeast-1"
S3_BUCKET_PRIVATE=""
S3_BUCKET_PUBLIC=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Initial Admin Bootstrap Protection ---
# Required only when running `pnpm admin:bootstrap` for the very first time
ADMIN_BOOTSTRAP_ENABLED="false"
ADMIN_BOOTSTRAP_TOKEN=""
ADMIN_INITIAL_PHONE=""
